{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vectorme",
  "version": "0.1.0",
  "identifier": "com.vectorme.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vectorme",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Graphics and Design",
    "shortDescription": "Turn raster images into clean SVG",
    "longDescription": "Vectorme is a local raster-to-SVG tracing tool. Load PNG, JPEG or WebP, tune the settings and export a clean SVG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
